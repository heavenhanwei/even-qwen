# Desktop Agent
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8787
# Use a long random value for every public or LAN deployment.
AGENT_PAIRING_TOKEN=

# Server-only Qwen Omni credentials. Never expose these through VITE_* variables.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
QWEN_OMNI_MODEL=qwen3.8-omni-flash-realtime
# Optional custom WebSocket endpoint and session directory.
QWEN_OMNI_ENDPOINT=
EVEN_QWEN_DATA_DIR=

# G2 client development settings. VITE_* values are bundled into browser code.
VITE_AGENT_WS_URL=ws://127.0.0.1:8787
# Development only. Production users enter the token on the phone page.
VITE_AGENT_PAIRING_TOKEN=

