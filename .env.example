# Desktop Agent
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8787
# Required before binding the agent to a LAN address such as 0.0.0.0.
AGENT_PAIRING_TOKEN=
# Optional absolute path to a Codex executable or codex.js entrypoint.
CODEX_CLI_PATH=

# Voice provider for this build. qwen is accepted as a legacy alias for qwen-omni.
VOICE_PROVIDER=qwen-omni
VOICE_FALLBACK_PROVIDER=paraformer

# Add only the provider key you use. Never expose these through VITE_* variables.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# cn-beijing | ap-southeast-1. The API key and workspace must be in this region.
DASHSCOPE_REGION=cn-beijing
QWEN_OMNI_MODEL=qwen3.8-omni-flash-realtime
PARAFORMER_MODEL=paraformer-realtime-v2
PARAFORMER_LANGUAGE_HINTS=zh
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# New voice-created Codex tasks use this directory (empty = the process cwd).
CODEX_WORKSPACE=
# read-only is the safe default. Set workspace-write only after explicitly accepting file writes.
CODEX_SANDBOX_MODE=read-only
# Optional; empty inherits the Codex default model.
CODEX_MODEL=

# G2 client development settings. VITE_* values are bundled into browser code.
VITE_AGENT_WS_URL=ws://127.0.0.1:8787
# Development-only pairing token. Replace this flow before distributing the app.
VITE_AGENT_PAIRING_TOKEN=

